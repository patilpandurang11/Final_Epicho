# ==============================================================================
# EPICHO PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment.
# NEVER commit real secrets or API keys into version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
DATABASE_URL=postgresql://epicho:change-me-db-password@127.0.0.1:5432/epicho
POSTGRES_PASSWORD=change-me-db-password

# Redis (Caching, Quotas & Rate Limiting - falls back to in-memory if unavailable in dev)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Tokens (Generate a strong 64-char random secret in production)
JWT_SECRET=change-me-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-or-hex-key

# Auth email: development writes messages to the ignored .dev-email-outbox/ directory.
# Configure SMTP_HOST, SMTP_FROM, and SMTP credentials for staging/production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=EpiCho <no-reply@localhost>
SMTP_STARTTLS=true
EMAIL_OUTBOX_DIR=.dev-email-outbox

# Google Gemini API (AI Kitchen & Reel Recipe Extraction)
GEMINI_API_KEY=
AI_PROVIDER=mock

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_SANDBOX_PAYMENTS=true

# Media Storage (local, s3, or r2)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
CDN_BASE_URL=http://localhost:8000/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
